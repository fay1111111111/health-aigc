# 复制为 .env 后填写。.env 只放在服务器上，不要提交到仓库。

# Docker 项目名：决定容器和数据卷的名字，避免和同目录下的旧项目撞名。
# 一套部署定下来后不要再改，否则会换成一个新的空数据库。
COMPOSE_PROJECT_NAME=health-aigc

# 这套部署服务的产品线（对应 products/ 下的文件夹名）
PRODUCT=sleep

# 对外端口（服务器上没被占用的端口）
API_PORT=8100

# 数据库（docker-compose 内部使用，改密码时两处一起改）
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://aigc:change-me@db:5432/aigc

# 阿里云百炼（通义千问 + 向量化）
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# DeepSeek（主模型调用失败时自动切换）
# 默认通过百炼调用，和千问共用上面的 DASHSCOPE_API_KEY，不用另开账号
BAILIAN_DEEPSEEK_MODEL=deepseek-v4.1-flash
# 只有想改走 DeepSeek 官网接口时才填下面两项（模型名以官网文档为准）
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-v4-flash

# 主模型 / 备用模型：qwen 或 deepseek
LLM_PRIMARY=qwen
LLM_FALLBACK=deepseek

# ---- 对外小程序「药王山沁养」 ----
# 微信公众平台 → 开发管理 → 开发设置 里的 AppID 和 AppSecret（密钥只写在服务器上）
WX_APPID=
WX_SECRET=
# 只在自己电脑上联调时设为 true：不配 AppID 也能用测试身份登录。服务器上必须保持 false
WX_DEV_LOGIN=false
# 对话方式：llm = 大模型根据审核过的问答和知识库回答（需要上面的模型 Key）；retrieval = 只做问答匹配
CHAT_MODE=llm
# 用户头像保存位置（docker-compose 已挂载成数据卷，不用改）
UPLOAD_DIR=/srv/uploads
