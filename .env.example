# 复制为 .env 后填写。.env 只放在服务器上，不要提交到仓库。

# 这套部署服务的产品线（对应 products/ 下的文件夹名）
PRODUCT=sleep

# 对外端口（服务器上没被占用的端口）
API_PORT=8100

# 数据库（docker-compose 内部使用，改密码时两处一起改）
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg://aigc:change-me@db:5432/aigc

# 阿里云百炼（通义千问 + 向量化）
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_DIM=1024

# DeepSeek（主模型调用失败时自动切换）
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-chat

# 主模型 / 备用模型：qwen 或 deepseek
LLM_PRIMARY=qwen
LLM_FALLBACK=deepseek
