<view class="page safe-bottom">
  <image class="wave" src="/images/wave.png" mode="widthFix" />
  <view class="top">
    <view class="logo-wrap"><image class="logo" src="/images/logo-round.png" /></view>
    <view class="large-title title">欢迎来到</view>
    <view class="large-title">药王山沁养</view>
    <view class="subtitle">一个可以慢慢问、慢慢了解颅骶放松和睡眠习惯的地方。</view>
  </view>

  <view class="section-label">你是为谁而来？</view>
  <view class="roles">
    <view wx:for="{{roles}}" wx:key="id" class="role fade-up {{role === item.id ? 'role-on' : ''}}" style="animation-delay: {{index * 90 + 100}}ms" data-id="{{item.id}}" bindtap="pickRole">
      <view class="ico-wrap role-ico"><image class="ico" src="/images/icons/{{item.icon}}.png" /></view>
      <view class="role-main">
        <view class="role-name">{{item.name}}</view>
        <view class="role-desc">{{item.desc}}</view>
      </view>
      <view class="check">{{role === item.id ? '✓' : ''}}</view>
    </view>
  </view>

  <view class="section-label">怎么称呼你（可以不填）</view>
  <view class="card">
    <view class="row">
      <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onAvatar">
        <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
        <view wx:else class="avatar-img avatar-empty">头像</view>
      </button>
      <input class="nick" type="nickname" value="{{nickname}}" placeholder="昵称" placeholder-class="placeholder" maxlength="32" bindinput="onNick" bindblur="onNick" />
    </view>
  </view>

  <view class="agree" bindtap="toggleAgree">
    <view class="box {{agree ? 'box-on' : ''}}">{{agree ? '✓' : ''}}</view>
    <view class="agree-text">
      我已阅读并同意
      <text class="link" data-type="terms" catchtap="openLegal">《用户协议》</text>和<text class="link" data-type="privacy" catchtap="openLegal">《隐私政策》</text>
    </view>
  </view>

  <view class="btn press {{canSubmit ? '' : 'btn-disabled'}}" hover-class="{{canSubmit ? 'press-hover' : ''}}" bindtap="submit">{{submitting ? '请稍候…' : '开始使用'}}</view>
  <view class="note tip">使用微信身份登录，不需要手机号。本小程序提供的是放松与睡眠习惯方面的信息，不是医疗服务。</view>
</view>
