.chat { height: 100vh; display: flex; flex-direction: column; }
.stream { flex: 1; height: 0; box-sizing: border-box; padding: 0 32rpx; }

/* 顶部插画：山和路是一张图，天上的月亮 / 太阳、星星、云是动画 */
.hero { position: relative; height: 400rpx; margin-top: 16rpx; border-radius: 36rpx; overflow: hidden; background: #E3EFE9; }
.hero-bg { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.sky { position: absolute; left: 0; top: 0; width: 100%; height: 100%; }
.sky-night { background: linear-gradient(180deg, rgba(38, 76, 68, 0.72), rgba(59, 111, 94, 0.18) 70%, rgba(59, 111, 94, 0)); }
.orbit { position: absolute; right: 64rpx; top: 44rpx; width: 84rpx; height: 84rpx; border-radius: 50%; animation: floaty 6s ease-in-out infinite; }
.sky-day .orbit { background: #FBE7B5; box-shadow: 0 0 0 18rpx rgba(251, 231, 181, 0.35), 0 0 0 40rpx rgba(251, 231, 181, 0.16); }
.sky-night .orbit { background: transparent; box-shadow: -22rpx 14rpx 0 0 #FDF7EE; right: 44rpx; top: 30rpx; }
.star { position: absolute; width: 10rpx; height: 10rpx; border-radius: 50%; background: #FDF7EE; animation: twinkle 3s ease-in-out infinite; }
.s1 { left: 96rpx; top: 52rpx; }
.s2 { left: 260rpx; top: 32rpx; width: 7rpx; height: 7rpx; animation-delay: 0.8s; }
.s3 { left: 400rpx; top: 84rpx; animation-delay: 1.6s; }
.s4 { left: 190rpx; top: 110rpx; width: 6rpx; height: 6rpx; animation-delay: 2.2s; }
.cloud { position: absolute; left: 300rpx; top: 76rpx; width: 120rpx; height: 34rpx; border-radius: 34rpx; background: rgba(255, 255, 255, 0.75); animation: drift 9s ease-in-out infinite alternate; }
.cloud::before { content: ""; position: absolute; left: 26rpx; top: -18rpx; width: 54rpx; height: 54rpx; border-radius: 50%; background: rgba(255, 255, 255, 0.75); }
.hero-text { position: absolute; left: 36rpx; right: 36rpx; top: 36rpx; }
.hero-logo { margin-bottom: 20rpx; animation: floaty 7s ease-in-out infinite; }
.hello { font-size: 52rpx; font-weight: 700; line-height: 1.25; color: #23423A; }
.hello-sub { margin-top: 8rpx; max-width: 440rpx; color: #4C6A61; font-size: 26rpx; line-height: 1.5; }
.hero-night .hello { color: #FDF7EE; }
.hero-night .hello-sub { color: rgba(253, 247, 238, 0.86); }
.load-error { margin-top: 32rpx; color: var(--sub); font-size: 28rpx; text-align: center; }

.cats { margin-top: 32rpx; }
.qlist { margin-top: 20rpx; }
.q-text { padding: 26rpx 0; line-height: 1.45; font-size: 30rpx; }
.q-ico { width: 60rpx; height: 60rpx; border-radius: 50%; margin-right: 20rpx; }
.q-ico .ico { width: 34rpx; height: 34rpx; }

.divider { margin: 40rpx 0 8rpx; text-align: center; color: var(--hint); font-size: 24rpx; }

.line { display: flex; margin-top: 28rpx; animation: rise 0.28s ease-out; }
.line-user { justify-content: flex-end; }
.avatar { flex: none; margin-right: 16rpx; margin-top: 4rpx; }
.bot-col { flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
.bubble { max-width: 560rpx; padding: 22rpx 28rpx; border-radius: 36rpx; font-size: 30rpx; line-height: 1.65; word-break: break-all; }
.bubble-user { background: var(--green); color: #fff; border-bottom-right-radius: 10rpx; }
.bubble-bot { background: var(--card); border-bottom-left-radius: 10rpx; }
.bubble-risk { background: var(--warn-soft); }
.risk-title { margin-bottom: 8rpx; color: var(--warn); font-weight: 600; }

.typing { display: flex; align-items: center; padding: 34rpx 30rpx; }
.dot { width: 14rpx; height: 14rpx; margin-right: 10rpx; border-radius: 50%; background: var(--green); opacity: 0.3; animation: blink 1.2s infinite; }
.dot:nth-child(2) { animation-delay: 0.2s; }
.dot:nth-child(3) { animation-delay: 0.4s; margin-right: 0; }

.related { margin-top: 20rpx; padding-top: 16rpx; border-top: 1px solid var(--line); }
.chip { margin-top: 12rpx; padding: 16rpx 22rpx; border-radius: 20rpx; background: var(--green-mist); color: var(--green-deep); font-size: 26rpx; line-height: 1.4; }
.chip-hover { background: var(--green-soft); }

.ai-tag { margin: 10rpx 0 0 8rpx; color: var(--hint); font-size: 22rpx; }
.feedback { display: flex; margin-top: 12rpx; }
.fb { display: flex; align-items: center; margin-right: 16rpx; padding: 8rpx 22rpx; border-radius: 999rpx; background: rgba(118, 118, 128, 0.1); color: var(--sub); font-size: 24rpx; }
.fb-on { background: var(--green-soft); color: var(--green-deep); font-weight: 600; animation: pop 0.3s ease-out; transform: none; }
.fb-ico { width: 30rpx; height: 30rpx; margin-right: 8rpx; }

.bottom-space { height: 40rpx; }

.composer { padding: 16rpx 24rpx calc(12rpx + env(safe-area-inset-bottom)); background: rgba(245, 246, 241, 0.96); border-top: 1px solid var(--line); }
.composer-inner { display: flex; align-items: center; background: var(--card); border-radius: 999rpx; padding: 8rpx 8rpx 8rpx 32rpx; }
.composer-input { flex: 1; height: 72rpx; font-size: 30rpx; }
.send { flex: none; height: 72rpx; line-height: 72rpx; padding: 0 32rpx; border-radius: 999rpx; background: var(--green); color: #fff; font-size: 28rpx; font-weight: 600; }
.send-off { background: #CFDFD7; }
.disclaimer { margin-top: 10rpx; text-align: center; color: var(--hint); font-size: 20rpx; }

@keyframes rise { from { opacity: 0; transform: translateY(16rpx); } to { opacity: 1; transform: none; } }
@keyframes blink { 0%, 80%, 100% { opacity: 0.25; transform: scale(0.85); } 40% { opacity: 1; transform: scale(1); } }
